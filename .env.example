# Public — safe to expose in the browser bundle.
# From the Neon console: Project > Auth (Managed Better Auth) and Project > Data API.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-000000.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-000000.apirest.us-east-2.aws.neon.tech/neondb/rest/v1

# Server-only — never expose in client code or commit real values.
# Used only to run db/schema.sql and the optional scripts/rls-check.mjs two-account
# verification script. Not read by the Next.js app itself (the app talks to Neon
# over the public Auth/Data API URLs above, and Postgres RLS enforces ownership).
DATABASE_URL=postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/neondb?sslmode=require

# Only needed if you add the server-side @neondatabase/auth Next.js integration
# instead of the client-side neon-js flow this project uses. Left as placeholders
# for spec completeness — unused by this implementation.
# NEON_AUTH_BASE_URL=https://ep-example-000000.neonauth.us-east-2.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=replace-with-a-32-plus-character-random-string
